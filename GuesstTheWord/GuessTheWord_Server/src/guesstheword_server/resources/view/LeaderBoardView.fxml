<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="550.0" prefWidth="800.0" styleClass="parent" stylesheets="@../styles/stylesheet.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="guesstheword_server.controller.LeaderBoardViewController">
   <children>
      <VBox spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
         </padding>
         <children>
            <VBox spacing="5.0">
               <children>
                  <Label text="CLASSIFICA UTENTI" textFill="#6747cd">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
                  <Label text="Giocatori ordinati per tempo medio di risposta ascendente (sono inclusi solo gli utenti con almeno una vittoria)." textFill="#7a7a7a">
                     <font>
                        <Font size="13.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            <TableView fx:id="leaderboardTable" prefHeight="400.0" prefWidth="740.0" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="usernameColumn" prefWidth="250.0" text="Nome Utente " />
                <TableColumn fx:id="victoriesColumn" prefWidth="200.0" text="Partite Vinte" />
                  <TableColumn fx:id="avgTimeColumn" prefWidth="280.0" text="Tempo Medio di Risposta (ms)" />
              </columns>
            </TableView>
         </children>
      </VBox>
   </children>
</AnchorPane>
