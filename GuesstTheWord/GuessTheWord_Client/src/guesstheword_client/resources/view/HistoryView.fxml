<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" styleClass="parent" stylesheets="@../styles/stylesheet.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="guesstheword_client.controller.HistoryViewController">
   <children>
      <VBox spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
         </padding>
         <children>
            <VBox spacing="5.0">
               <children>
                  <Label text="STORICO PARTITE" textFill="#6747cd">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
                  <Label text="Il resoconto di tutte le partite giocate." textFill="#7a7a7a">
                     <font>
                        <Font size="13.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            
            <TableView fx:id="historyTable" prefHeight="250.0" prefWidth="540.0" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="dateColumn" prefWidth="180.0" text="Data e Ora" />
                <TableColumn fx:id="resultColumn" prefWidth="100.0" text="Esito" />
                <TableColumn fx:id="wordColumn" prefWidth="250.0" text="Parola Segreta" />
              </columns>
            </TableView>
            
            <HBox alignment="CENTER_RIGHT" spacing="15.0">
               <children>
                  <Label fx:id="errorLabel" textFill="#ff3b30" />
                  <Button mnemonicParsing="false" onAction="#handleBackToLobby" styleClass="loginBtn" text="Nuova Partita">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
